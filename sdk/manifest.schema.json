{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GameSupport Plugin SDK 1.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "id",
    "name",
    "version",
    "author",
    "description",
    "type",
    "runtime",
    "permissions",
    "events",
    "files"
  ],
  "properties": {
    "manifest_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9_-]*){2,}$",
      "maxLength": 160
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "type": {
      "enum": ["event_provider", "ui"]
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "os", "arch", "executable", "protocol"],
          "properties": {
            "type": {
              "const": "native"
            },
            "os": {
              "const": ["windows"]
            },
            "arch": {
              "const": ["x86_64"]
            },
            "executable": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_./-]+\\.exe$"
            },
            "protocol": {
              "const": "gs-ipc/1.0"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {
            "type": {
              "const": "web"
            }
          }
        }
      ]
    },
    "permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "screen.capture",
          "events.emit",
          "filesystem.read",
          "filesystem.write",
          "network.client",
          "process.launch"
        ]
      }
    },
    "events": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
            "maxLength": 128
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      }
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pages"],
      "properties": {
        "pages": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "html", "script"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_-]{0,39}$"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              },
              "html": {
                "type": "string",
                "maxLength": 160
              },
              "script": {
                "type": "string",
                "maxLength": 160
              },
              "style": {
                "type": "string",
                "maxLength": 160
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "ui"
          }
        }
      },
      "then": {
        "required": ["ui"],
        "properties": {
          "runtime": {
            "properties": {
              "type": {
                "const": "web"
              }
            }
          },
          "events": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "runtime": {
            "properties": {
              "type": {
                "const": "native"
              }
            }
          }
        }
      }
    }
  ]
}
